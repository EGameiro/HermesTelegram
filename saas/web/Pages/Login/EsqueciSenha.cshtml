@page
@model HermesSaaS.Web.Pages.Login.EsqueciSenhaModel
@{
    ViewData["Title"] = "Esqueci a senha";
    Layout = "_Layout";
}
<div class="d-flex justify-content-center align-items-center" style="min-height: 90vh;">
    <div class="card p-4 shadow-sm" style="max-width: 400px; width: 100%;">
        <h3 class="text-hermes mb-1"><i class="bi bi-key"></i> Recuperar senha</h3>
        @if (Model.Enviado)
        {
            <div class="alert alert-success mt-3">
                Se houver uma conta com esse e-mail, enviamos um link para redefinir a senha. Verifique sua caixa de entrada.
            </div>
            <a asp-page="/Login/Index" class="text-hermes">← Voltar ao login</a>
        }
        else
        {
            <p class="text-muted mb-4">Informe seu e-mail e enviaremos um link para criar uma nova senha.</p>
            <form method="post">
                <div class="mb-3">
                    <label class="form-label">E-mail</label>
                    <input asp-for="Email" class="form-control" autofocus />
                </div>
                <button type="submit" class="btn btn-hermes w-100">Enviar link</button>
            </form>
            <p class="text-center mt-3 mb-0 small"><a asp-page="/Login/Index" class="text-hermes">Voltar ao login</a></p>
        }
    </div>
</div>
