# --- UAZAPI (WhatsApp) --- mesmo formato do Agente Clínica
UAZAPI_BASE_URL=https://SEU-SUBDOMINIO.uazapi.com
UAZAPI_TOKEN=seu_token_da_instancia
# (opcional) só mude se sua instância usar outro caminho de envio:
UAZAPI_SEND_PATH=/send/text

# --- Segurança do webhook (opcional) ---
# Se preenchido, o /webhook exige o header x-webhook-secret (ou ?secret=) igual a este valor.
WEBHOOK_SECRET=

# --- Cérebro (mesmo Groq do bot) ---
GROQ_API_KEY=gsk_...
GROQ_MODEL=openai/gpt-oss-120b
