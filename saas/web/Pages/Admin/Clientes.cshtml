@page
@model HermesSaaS.Web.Pages.Admin.ClientesModel
@{
    ViewData["Title"] = "Clientes";
    string Badge(string? s) => s switch
    {
        "ativo" => "bg-success", "trial" => "bg-info", "suspenso" => "bg-warning",
        "cancelado" or "inadimplente" => "bg-danger", _ => "bg-secondary"
    };
}
<h4 class="mb-4"><i class="bi bi-people text-hermes"></i> Clientes</h4>

@if (!string.IsNullOrEmpty(Model.Msg))
{
    <div class="alert alert-success py-2">@Model.Msg</div>
}

<div class="card p-0">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th class="ps-3">Cliente</th>
                    <th>Plano</th>
                    <th>Status</th>
                    <th>WhatsApp</th>
                    <th>Desde</th>
                    <th>Limites (compromissos / contas)</th>
                    <th class="text-end pe-3">Ativar plano</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var c in Model.Clientes)
            {
                <tr>
                    <td class="ps-3">
                        <div class="fw-semibold">@c.Nome</div>
                        <div class="text-muted small">@c.Email</div>
                    </td>
                    <td>@(c.PlanoNome ?? "—")</td>
                    <td>
                        <span class="badge @Badge(c.StatusAssinatura)">@(c.StatusAssinatura ?? c.StatusUsuario)</span>
                        @if (c.StatusAssinatura == "trial" && c.TrialAte is DateOnly ate)
                        {
                            <div class="text-muted small">até @ate.ToString("dd/MM")</div>
                        }
                    </td>
                    <td>
                        @if (c.Conectado)
                        {
                            <span class="text-success"><i class="bi bi-check-circle-fill"></i></span>
                        }
                        else
                        {
                            <span class="text-muted"><i class="bi bi-dash-circle"></i></span>
                        }
                    </td>
                    <td class="text-muted small">@c.CriadoEm.ToString("dd/MM/yyyy")</td>
                    <td>
                        <form method="post" asp-page-handler="Limites" class="d-inline-flex align-items-center gap-1">
                            <input type="hidden" name="usuarioId" value="@c.UsuarioId" />
                            <i class="bi bi-calendar-event text-muted small" title="Compromissos em aberto"></i>
                            <input type="number" name="limiteCompromissos" value="@c.LimiteCompromissos" min="0" class="form-control form-control-sm" style="width:72px;" title="Compromissos em aberto" />
                            <i class="bi bi-cash-coin text-muted small" title="Contas"></i>
                            <input type="number" name="limiteContas" value="@c.LimiteContas" min="0" class="form-control form-control-sm" style="width:72px;" title="Contas (pagas ou não)" />
                            <button class="btn btn-sm btn-outline-secondary" type="submit" title="Salvar limites"><i class="bi bi-check-lg"></i></button>
                        </form>
                    </td>
                    <td class="text-end pe-3">
                        <form method="post" asp-page-handler="Ativar" class="d-inline-flex gap-1 justify-content-end">
                            <input type="hidden" name="usuarioId" value="@c.UsuarioId" />
                            <select name="planoId" class="form-select form-select-sm" style="width:auto;">
                                @foreach (var p in Model.Planos)
                                {
                                    <option value="@p.Id">@p.Nome</option>
                                }
                            </select>
                            <button class="btn btn-sm btn-hermes" type="submit">Ativar</button>
                        </form>
                    </td>
                </tr>
            }
            @if (!Model.Clientes.Any())
            {
                <tr><td colspan="7" class="text-center text-muted py-4">Nenhum cliente cadastrado ainda.</td></tr>
            }
            </tbody>
        </table>
    </div>
</div>
