@page
@model HermesSaaS.Web.Pages.Telegram.ConectarModel
@{
    ViewData["Title"] = "Conectar Telegram";
    var link = Model.Token != null
        ? $"https://t.me/{Model.BotUsername}?start={Model.Token}" : null;
}
<h4 class="mb-4"><i class="bi bi-telegram text-hermes"></i> Conectar o Telegram</h4>

@if (Model.Conectado)
{
    <div class="card p-4" style="max-width: 640px;">
        <h5 class="text-success mb-2"><i class="bi bi-check-circle-fill"></i> Telegram conectado</h5>
        <p class="text-muted mb-3">
            Seu assistente já está ativo
            @if (!string.IsNullOrEmpty(Model.Vinculo?.TelegramUsername)) { <text>para <strong>@@@Model.Vinculo!.TelegramUsername</strong></text>}.
            É só conversar com o bot no Telegram.
        </p>

        @if (link != null)
        {
            <div class="alert alert-info">
                <div class="mb-2"><strong>Novo código gerado</strong> — para conectar <em>outro</em> Telegram (isso substitui o atual):</div>
                <ol class="mb-2">
                    <li class="mb-2">
                        Abra o bot:
                        <a href="@link" target="_blank" class="btn btn-hermes btn-sm ms-1">
                            <i class="bi bi-box-arrow-up-right"></i> Abrir @@@Model.BotUsername
                        </a>
                    </li>
                    <li>Ou envie ao bot: <code class="bg-light px-2 py-1 rounded">/start @Model.Token</code></li>
                </ol>
                <div class="small text-muted mb-0">
                    Válido até @Model.TokenExpiraEm?.ToLocalTime().ToString("HH:mm") (30 min). Recarregue a página após conectar.
                </div>
            </div>
        }
        else
        {
            <form method="post" asp-page-handler="Gerar">
                <button class="btn btn-outline-secondary btn-sm" type="submit">Gerar novo código (reconectar outro Telegram)</button>
            </form>
        }
    </div>
}
else
{
    <div class="card p-4" style="max-width: 640px;">
        <p>Para ativar seu assistente, conecte seu Telegram em 2 passos:</p>
        @if (link != null)
        {
            <ol class="mb-3">
                <li class="mb-2">
                    Abra o bot no Telegram:
                    <a href="@link" target="_blank" class="btn btn-hermes btn-sm ms-1">
                        <i class="bi bi-box-arrow-up-right"></i> Abrir @@@Model.BotUsername
                    </a>
                </li>
                <li>
                    Ou, dentro do bot, envie:
                    <code class="d-inline-block bg-light px-2 py-1 rounded mt-1">/start @Model.Token</code>
                </li>
            </ol>
            <p class="text-muted small mb-0">
                Código válido até @Model.TokenExpiraEm?.ToLocalTime().ToString("HH:mm") (30 min). Recarregue esta página após conectar.
            </p>
        }
        else
        {
            <form method="post" asp-page-handler="Gerar">
                <button class="btn btn-hermes" type="submit"><i class="bi bi-key"></i> Gerar código de conexão</button>
            </form>
        }
    </div>
}
