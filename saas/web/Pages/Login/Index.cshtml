@page "/Login"
@model HermesSaaS.Web.Pages.Login.IndexModel
@{
    ViewData["Title"] = "Entrar";
    Layout = "_Layout";
}
<div class="d-flex justify-content-center align-items-center" style="min-height: 90vh;">
    <div class="card p-4 shadow-sm" style="max-width: 400px; width: 100%;">
        <h3 class="text-hermes mb-1"><i class="bi bi-robot"></i> Hermes</h3>
        <p class="text-muted mb-4">Entre na sua conta.</p>
        @if (!string.IsNullOrEmpty(Model.Erro))
        {
            <div class="alert alert-danger py-2">@Model.Erro</div>
        }
        <form method="post">
            <div class="mb-3">
                <label class="form-label">E-mail</label>
                <input asp-for="Input.Email" class="form-control" autofocus />
            </div>
            <div class="mb-3">
                <label class="form-label">Senha</label>
                <input asp-for="Input.Senha" type="password" class="form-control" />
            </div>
            <button type="submit" class="btn btn-hermes w-100">Entrar</button>
        </form>
        <p class="text-center mt-3 mb-0 small">
            Não tem conta? <a asp-page="/Cadastro" class="text-hermes">Cadastre-se</a>
        </p>
    </div>
</div>
