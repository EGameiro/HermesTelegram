# --- UAZAPI (WhatsApp) ---
UAZAPI_BASE_URL=https://SEU-SUBDOMINIO.uazapi.com
UAZAPI_TOKEN=seu_token_da_instancia
# Ajuste se sua versão do UAZAPI usar outro caminho/header (confira no Agente Clínica):
UAZAPI_SEND_PATH=/send/text
UAZAPI_TOKEN_HEADER=token

# --- Cérebro (mesmo Groq do bot) ---
GROQ_API_KEY=gsk_...
GROQ_MODEL=openai/gpt-oss-120b
