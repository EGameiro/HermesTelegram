@page
@model HermesSaaS.Web.Pages.Contas.IndexModel
@{
    ViewData["Title"] = "Minhas contas";
    string Money(decimal? v) => v is null ? "—" : "R$ " + v.Value.ToString("N2", new System.Globalization.CultureInfo("pt-BR"));
    var hoje = DateOnly.FromDateTime(DateTime.UtcNow);
}
<h4 class="mb-4"><i class="bi bi-cash-coin text-hermes"></i> Minhas contas a pagar</h4>

<div class="row g-3">
    <div class="col-12 col-lg-4">
        <div class="card p-3">
            <h6 class="text-muted text-uppercase small mb-3">Nova conta</h6>
            <form method="post" asp-page-handler="Add">
                <div class="mb-2">
                    <label class="form-label small">Descrição</label>
                    <input asp-for="Input.Descricao" class="form-control" placeholder="Ex.: Luz" />
                </div>
                <div class="mb-2">
                    <label class="form-label small">Valor (opcional)</label>
                    <input asp-for="Input.Valor" class="form-control" placeholder="100,00" />
                </div>
                <div class="mb-3">
                    <label class="form-label small">Vencimento</label>
                    <input asp-for="Input.Vencimento" type="date" class="form-control" />
                </div>
                <button class="btn btn-hermes w-100" type="submit"><i class="bi bi-plus-lg"></i> Adicionar</button>
            </form>
        </div>
    </div>

    <div class="col-12 col-lg-8">
        <div class="card p-0">
            <div class="p-3 border-bottom d-flex justify-content-between align-items-center">
                <span class="fw-semibold">Pendentes</span>
                <span class="badge bg-danger-subtle text-danger">Total: @Money(Model.TotalPendente)</span>
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <tbody>
                    @foreach (var c in Model.Contas)
                    {
                        var vencida = !c.Pago && c.Vencimento < hoje;
                        <tr class="@(c.Pago ? "text-muted" : "")">
                            <td class="ps-3">
                                <div class="fw-semibold @(c.Pago ? "text-decoration-line-through" : "")">@c.Descricao</div>
                                <div class="small @(vencida ? "text-danger" : "text-muted")">
                                    vence @c.Vencimento.ToString("dd/MM/yyyy") @(vencida ? "(vencida)" : "")
                                </div>
                            </td>
                            <td class="text-end">@Money(c.Valor)</td>
                            <td class="text-end pe-3" style="width: 130px;">
                                @if (!c.Pago)
                                {
                                    <form method="post" asp-page-handler="Pagar" class="d-inline">
                                        <input type="hidden" name="id" value="@c.Id" />
                                        <button class="btn btn-sm btn-outline-success" title="Marcar paga"><i class="bi bi-check-lg"></i></button>
                                    </form>
                                }
                                else
                                {
                                    <span class="badge bg-success-subtle text-success me-1">paga</span>
                                }
                                <form method="post" asp-page-handler="Remover" class="d-inline" onsubmit="return confirm('Remover esta conta?');">
                                    <input type="hidden" name="id" value="@c.Id" />
                                    <button class="btn btn-sm btn-outline-danger" title="Remover"><i class="bi bi-trash"></i></button>
                                </form>
                            </td>
                        </tr>
                    }
                    @if (!Model.Contas.Any())
                    {
                        <tr><td class="text-center text-muted py-4">Nenhuma conta cadastrada. 🎉</td></tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
