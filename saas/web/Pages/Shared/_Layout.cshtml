@using System.Security.Claims
@{
    var isAuth = User.Identity?.IsAuthenticated == true;
    var isAdmin = User.IsInRole("Admin");
    var nome = User.FindFirstValue("NomeCompleto");
    string Active(string page) =>
        (ViewContext.RouteData.Values["page"]?.ToString() ?? "").StartsWith(page) ? "active" : "";
}
<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · Hermes</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <style>
        :root {
            --h-primary: #5A4FCF; --h-primary-dark: #443bb0;
            --h-accent: #22C55E; --h-bg: #F6F7FB; --h-text: #1F2430;
        }
        body { background: var(--h-bg); color: var(--h-text); }
        .navbar-brand { font-weight: 700; letter-spacing: .3px; }
        .bg-hermes { background: var(--h-primary) !important; }
        .btn-hermes { background: var(--h-primary); border-color: var(--h-primary); color: #fff; }
        .btn-hermes:hover { background: var(--h-primary-dark); border-color: var(--h-primary-dark); color: #fff; }
        .text-hermes { color: var(--h-primary) !important; }
        .sidebar .nav-link { color: #495057; border-radius: .5rem; margin-bottom: .15rem; }
        .sidebar .nav-link.active { background: var(--h-primary); color: #fff; }
        .sidebar .nav-link:hover:not(.active) { background: #ececf6; }
        .sidebar .nav-link.nav-help:not(.active) {
            background: rgba(34,197,94,.12); color: #157347; font-weight: 600;
            border: 1px solid rgba(34,197,94,.35);
        }
        .sidebar .nav-link.nav-help:not(.active):hover { background: rgba(34,197,94,.22); }
        .card { border: none; box-shadow: 0 1px 3px rgba(0,0,0,.06); border-radius: .75rem; }
        .wa-float {
            position: fixed; right: 20px; bottom: 20px; z-index: 1080;
            width: 56px; height: 56px; border-radius: 50%;
            background: #25D366; color: #fff;
            display: flex; align-items: center; justify-content: center;
            font-size: 30px; text-decoration: none;
            box-shadow: 0 4px 14px rgba(0,0,0,.28);
            transition: transform .15s ease, box-shadow .15s ease;
        }
        .wa-float:hover { color: #fff; transform: scale(1.08); box-shadow: 0 6px 20px rgba(0,0,0,.32); }
    </style>
</head>
<body>
@if (isAuth)
{
    <nav class="navbar navbar-dark bg-hermes px-3">
        <span class="navbar-brand mb-0"><i class="bi bi-robot"></i> Hermes</span>
        <div class="d-flex align-items-center text-white-50 small">
            <span class="me-3 d-none d-sm-inline">@nome</span>
            <form method="post" asp-page="/Login/Logout" class="m-0">
                <button class="btn btn-sm btn-outline-light" type="submit"><i class="bi bi-box-arrow-right"></i> Sair</button>
            </form>
        </div>
    </nav>
    <div class="container-fluid">
        <div class="row">
            <aside class="col-12 col-md-3 col-lg-2 sidebar py-3">
                <nav class="nav flex-column">
                    <a class="nav-link @Active("/Dashboard")" asp-page="/Dashboard"><i class="bi bi-speedometer2 me-1"></i> Painel</a>
                    @* Ocultos temporariamente (não excluir) — reexibir quando liberar p/ os usuários:
                    <a class="nav-link @Active("/Contas")" asp-page="/Contas/Index"><i class="bi bi-cash-coin me-1"></i> Minhas contas</a>
                    <a class="nav-link @Active("/Compromissos")" asp-page="/Compromissos/Index"><i class="bi bi-calendar-event me-1"></i> Compromissos</a>
                    *@
                    <a class="nav-link @Active("/Telegram")" asp-page="/Telegram/Conectar"><i class="bi bi-telegram me-1"></i> Conectar Telegram</a>
                    <a class="nav-link @Active("/Conta/Configuracoes")" asp-page="/Conta/Configuracoes"><i class="bi bi-sliders me-1"></i> Configurações</a>
                    <a class="nav-link @Active("/Faturas")" asp-page="/Faturas/Index"><i class="bi bi-receipt me-1"></i> Faturas</a>
                    <a class="nav-link @Active("/Conta/Index")" asp-page="/Conta/Index"><i class="bi bi-person-gear me-1"></i> Minha conta</a>
                    <a class="nav-link nav-help @Active("/ComoConfigurar")" asp-page="/ComoConfigurar"><i class="bi bi-stars me-1"></i> Como configurar o Hermes</a>
                    @if (isAdmin)
                    {
                        <hr class="my-2" />
                        <span class="text-uppercase text-muted small px-3 mb-1">Admin</span>
                        <a class="nav-link @Active("/Admin/Clientes")" asp-page="/Admin/Clientes"><i class="bi bi-people me-1"></i> Clientes</a>
                    }
                </nav>
            </aside>
            <main class="col-12 col-md-9 col-lg-10 py-4">
                @if (TempData["Ok"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show">@TempData["Ok"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
                }
                @if (TempData["Erro"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show">@TempData["Erro"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
                }
                @RenderBody()
            </main>
        </div>
    </div>
}
else
{
    <main>@RenderBody()</main>
}
@if (isAuth)
{
    <a href="https://wa.me/5512992231044" target="_blank" rel="noopener"
       class="wa-float" title="Fale conosco no WhatsApp" aria-label="Fale conosco no WhatsApp">
        <i class="bi bi-whatsapp"></i>
    </a>
}
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
