# Copie para .env e preencha. No Dokploy, cole estas variáveis na aba Environment do stack.

# Token do bot criado no @BotFather
TELEGRAM_TOKEN=123456:ABC-seu-token-aqui

# (Opcional) Restringe o uso do bot aos seus chat_ids, separados por vírgula.
# Descubra o seu enviando /id ao bot depois que ele subir.
ALLOWED_CHAT_IDS=
