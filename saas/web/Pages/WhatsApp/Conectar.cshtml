@page
@model HermesSaaS.Web.Pages.WhatsApp.ConectarModel
@{
    ViewData["Title"] = "Conectar WhatsApp";
    // wa.me abre a conversa com o bot já com o código digitado (o cliente só aperta enviar).
    var link = (!string.IsNullOrEmpty(Model.Token) && !string.IsNullOrEmpty(Model.BotNumero))
        ? $"https://wa.me/{Model.BotNumero}?text={Uri.EscapeDataString(Model.Token!)}" : null;
}
<h4 class="mb-4"><i class="bi bi-whatsapp text-success"></i> Conectar o WhatsApp</h4>

@if (Model.Conectado)
{
    <div class="card p-4" style="max-width: 640px;">
        <h5 class="text-success mb-2"><i class="bi bi-check-circle-fill"></i> WhatsApp conectado</h5>
        <p class="text-muted mb-3">
            Seu assistente já está ativo
            @if (!string.IsNullOrEmpty(Model.Vinculo?.NomeExibicao)) { <text>para <strong>@Model.Vinculo!.NomeExibicao</strong></text>}.
            É só conversar com o bot no WhatsApp.
        </p>

        @if (link != null)
        {
            <div class="alert alert-info">
                <div class="mb-2"><strong>Novo código gerado</strong> — para conectar <em>outro</em> WhatsApp (isso substitui o atual):</div>
                <ol class="mb-2">
                    <li class="mb-2">
                        Abra a conversa:
                        <a href="@link" target="_blank" class="btn btn-success btn-sm ms-1">
                            <i class="bi bi-box-arrow-up-right"></i> Abrir no WhatsApp
                        </a>
                    </li>
                    <li>Ou envie ao bot só o código: <code class="bg-light px-2 py-1 rounded">@Model.Token</code></li>
                </ol>
                <div class="small text-muted mb-0">
                    Válido até @Model.TokenExpiraEm?.ToLocalTime().ToString("HH:mm") (30 min). Recarregue a página após conectar.
                </div>
            </div>
        }
        else
        {
            <form method="post" asp-page-handler="Gerar">
                <button class="btn btn-outline-secondary btn-sm" type="submit">Gerar novo código (reconectar outro WhatsApp)</button>
            </form>
        }
    </div>
}
else
{
    <div class="card p-4" style="max-width: 640px;">
        <p>Para ativar seu assistente, conecte seu WhatsApp em 2 passos:</p>
        @if (string.IsNullOrEmpty(Model.BotNumero))
        {
            <div class="alert alert-warning mb-3">
                O número do bot de WhatsApp ainda não foi configurado. Fale com o suporte.
            </div>
        }
        @if (link != null)
        {
            <ol class="mb-3">
                <li class="mb-2">
                    Abra a conversa com o bot no WhatsApp:
                    <a href="@link" target="_blank" class="btn btn-success btn-sm ms-1">
                        <i class="bi bi-box-arrow-up-right"></i> Abrir no WhatsApp
                    </a>
                </li>
                <li>
                    Envie a mensagem (o código já vem preenchido). Ou digite só:
                    <code class="d-inline-block bg-light px-2 py-1 rounded mt-1">@Model.Token</code>
                </li>
            </ol>
            <p class="text-muted small mb-0">
                Código válido até @Model.TokenExpiraEm?.ToLocalTime().ToString("HH:mm") (30 min). Recarregue esta página após conectar.
            </p>
        }
        else
        {
            <form method="post" asp-page-handler="Gerar">
                <button class="btn btn-success" type="submit"><i class="bi bi-key"></i> Gerar código de conexão</button>
            </form>
        }
    </div>
}
