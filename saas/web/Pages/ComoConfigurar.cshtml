@page
@model HermesSaaS.Web.Pages.ComoConfigurarModel
@{
    ViewData["Title"] = "Como configurar o Hermes";
}

<style>
    .hermes-tut{
        --tut-brand:#5A4FCF; --tut-brand-2:#7a6ff0; --tut-brand-soft:#efeefe;
        --tut-tg:#229ED9; --tut-tg-soft:#e6f4fc;
        --tut-ink:#1F2430; --tut-muted:#6c6c86; --tut-line:#e8e8f3;
        --tut-ok:#16a34a; --tut-ok-soft:#e9f7ee; --tut-bg:#F6F7FB;
        max-width:720px;
    }
    .hermes-tut .head{display:flex;align-items:center;gap:14px;margin-bottom:6px}
    .hermes-tut .logo{
        width:52px;height:52px;border-radius:14px;flex:0 0 auto;
        background:linear-gradient(135deg,var(--tut-brand),var(--tut-brand-2));
        display:flex;align-items:center;justify-content:center;font-size:28px;
        box-shadow:0 8px 20px rgba(90,79,207,.35);
    }
    .hermes-tut .eyebrow{font-size:.75rem;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:var(--tut-brand)}
    .hermes-tut h1{font-size:clamp(1.4rem,4vw,1.9rem);line-height:1.15;letter-spacing:-.01em;margin:2px 0 0;color:var(--tut-ink)}
    .hermes-tut .lead{color:var(--tut-muted);font-size:1.02rem;margin:14px 0 26px;max-width:60ch}

    .hermes-tut ol.steps{list-style:none;position:relative;display:flex;flex-direction:column;gap:0;margin:0;padding:0}
    .hermes-tut ol.steps::before{content:"";position:absolute;left:19px;top:12px;bottom:34px;width:2px;background:var(--tut-line)}
    .hermes-tut li.step{position:relative;display:flex;gap:18px;padding:0 0 22px 0}
    .hermes-tut .num{
        position:relative;z-index:1;flex:0 0 auto;width:40px;height:40px;border-radius:50%;
        background:var(--tut-brand);color:#fff;font-weight:800;font-size:1.05rem;
        display:flex;align-items:center;justify-content:center;box-shadow:0 0 0 5px var(--tut-bg);
    }
    .hermes-tut .stepbody{flex:1;padding-top:5px}
    .hermes-tut .stepbody h3{font-size:1.08rem;margin:0 0 4px;letter-spacing:-.01em;color:var(--tut-ink)}
    .hermes-tut .stepbody p{color:var(--tut-muted);font-size:.98rem;margin:0}
    .hermes-tut .stepbody p a{color:var(--tut-brand);font-weight:600;text-decoration:none;border-bottom:1.5px solid var(--tut-brand-soft)}
    .hermes-tut .stepbody p a:hover{border-bottom-color:var(--tut-brand)}

    .hermes-tut .chip{display:inline-flex;align-items:center;gap:7px;font-weight:700;font-size:.92rem;
        padding:8px 14px;border-radius:10px;margin-top:10px;white-space:nowrap;text-decoration:none}
    .hermes-tut .chip.brand{background:var(--tut-brand);color:#fff}
    .hermes-tut .chip.tg{background:var(--tut-tg);color:#fff}
    .hermes-tut .codebox{
        display:inline-flex;align-items:center;gap:8px;margin-top:10px;
        background:#faf9ff;border:1.5px dashed var(--tut-brand-2);border-radius:10px;
        padding:9px 14px;font-family:ui-monospace,"SF Mono",Menlo,Consolas,monospace;
        font-weight:700;color:var(--tut-brand);font-size:.98rem;
    }
    .hermes-tut .codebox .tag{color:var(--tut-muted);font-weight:600}
    .hermes-tut .hint{display:block;margin-top:8px;font-size:.86rem;color:var(--tut-muted)}
    .hermes-tut li.step.done .num{background:var(--tut-ok)}
    .hermes-tut .okbadge{display:inline-flex;align-items:center;gap:7px;margin-top:10px;background:var(--tut-ok-soft);
        color:var(--tut-ok);font-weight:700;font-size:.92rem;padding:8px 13px;border-radius:10px}

    .hermes-tut .final{
        margin-top:12px;background:#fff;border:1px solid var(--tut-line);border-radius:18px;
        padding:22px 22px 20px;box-shadow:0 10px 30px rgba(40,40,90,.06);
    }
    .hermes-tut .final h2{font-size:1.15rem;display:flex;align-items:center;gap:9px;margin:0 0 4px;color:var(--tut-ink)}
    .hermes-tut .final .sub{color:var(--tut-muted);font-size:.95rem;margin:0 0 16px}
    .hermes-tut .examples{display:flex;flex-direction:column;gap:10px}
    .hermes-tut .ex{display:flex;gap:11px;align-items:flex-start;background:#f7f7fd;border-radius:12px;padding:11px 13px}
    .hermes-tut .ex .em{font-size:1.15rem;line-height:1.3;flex:0 0 auto}
    .hermes-tut .ex .tx{font-size:.96rem;color:var(--tut-ink)}
    .hermes-tut .ex .tx span{color:var(--tut-muted);display:block;font-size:.86rem;margin-top:1px}
    .hermes-tut .foot{margin-top:22px;color:var(--tut-muted);font-size:.86rem}
    .hermes-tut .foot b{color:var(--tut-brand)}
</style>

<div class="hermes-tut">
    <div class="head">
        <div class="logo">🤖</div>
        <div>
            <div class="eyebrow">Guia rápido</div>
            <h1>Como conectar seu Telegram ao Hermes</h1>
        </div>
    </div>
    <p class="lead">Em poucos minutos o Hermes vira seu assistente pessoal no Telegram — cadastrando contas, agendando compromissos e te lembrando na hora certa. Siga os 7 passos:</p>

    <ol class="steps">
        <li class="step">
            <div class="num">1</div>
            <div class="stepbody">
                <h3>Tenha o Telegram no celular</h3>
                <p>Instale o app <b>Telegram</b> (grátis, Android ou iPhone) e crie sua conta, caso ainda não tenha.</p>
            </div>
        </li>
        <li class="step">
            <div class="num">2</div>
            <div class="stepbody">
                <h3>Faça seu cadastro no site</h3>
                <p>Acesse <a href="https://hermes.digiplay.net.br/">hermes.digiplay.net.br</a> e cadastre-se. É rápido: só <b>nome, e‑mail e senha</b>.</p>
            </div>
        </li>
        <li class="step">
            <div class="num">3</div>
            <div class="stepbody">
                <h3>Você cai na tela “Conectar Telegram”</h3>
                <p>Assim que entrar, o site já abre a página de conexão do Telegram.</p>
            </div>
        </li>
        <li class="step">
            <div class="num">4</div>
            <div class="stepbody">
                <h3>Gere seu código de conexão</h3>
                <p>Clique no botão:</p>
                <span class="chip brand"><i class="bi bi-key-fill"></i> Gerar código de conexão</span>
            </div>
        </li>
        <li class="step">
            <div class="num">5</div>
            <div class="stepbody">
                <h3>Anote o código que aparecer</h3>
                <p>Vai surgir um comando começando com <b>/start</b> seguido de um código só seu:</p>
                <span class="codebox"><span class="tag">exemplo:</span> /start XXXXXXXX</span>
                <span class="hint">⏱️ O código vale por 30 minutos. Cada pessoa tem um código diferente.</span>
            </div>
        </li>
        <li class="step">
            <div class="num">6</div>
            <div class="stepbody">
                <h3>Abra o bot no Telegram</h3>
                <p>Toque no link abaixo — ele abre direto a conversa do bot no seu Telegram:</p>
                <a href="https://t.me/digiplayhermesbot" class="chip tg" target="_blank" rel="noopener"><i class="bi bi-telegram"></i> Abrir @@digiplayhermesbot</a>
            </div>
        </li>
        <li class="step done">
            <div class="num">7</div>
            <div class="stepbody">
                <h3>Envie o código no bot</h3>
                <p>Na conversa do bot, digite (ou cole) aquele <b>/start</b> com o seu código e envie.</p>
                <span class="okbadge"><i class="bi bi-check-circle-fill"></i> Pronto! Aparece “Conta conectada”.</span>
                <span class="hint">Depois, é só recarregar a página do site para ver o Telegram como conectado.</span>
            </div>
        </li>
    </ol>

    <div class="final">
        <h2>💬 Agora é só falar com o Hermes</h2>
        <p class="sub">Fale ou escreva naturalmente — por texto ou áudio. Alguns exemplos:</p>
        <div class="examples">
            <div class="ex"><span class="em">💡</span><div class="tx"><b>“Cadastra a conta de luz de 120 reais, vence dia 18.”</b><span>Ele salva e te lembra no vencimento.</span></div></div>
            <div class="ex"><span class="em">📅</span><div class="tx"><b>“Me avisa amanhã às 9h da reunião com a Adriana.”</b><span>Ele agenda e avisa um pouco antes.</span></div></div>
            <div class="ex"><span class="em">🔁</span><div class="tx"><b>“Tomar remédio de 8 em 8 horas a partir de hoje às 10h por 5 dias.”</b><span>Ele cria e te lembra em cada horário.</span></div></div>
            <div class="ex"><span class="em">🔎</span><div class="tx"><b>“Quais compromissos eu tenho hoje?”</b><span>Ele lista sua agenda na hora.</span></div></div>
            <div class="ex"><span class="em">💰</span><div class="tx"><b>“Quanto tenho pra pagar esse mês?”</b><span>Ele soma suas contas e responde.</span></div></div>
        </div>
    </div>

    <p class="foot">Precisa de ajuda? Refaça o passo <b>4</b> (em <a href="https://hermes.digiplay.net.br/Telegram/Conectar" class="text-hermes">Conectar Telegram</a>) para gerar um novo código a qualquer momento.</p>
</div>
