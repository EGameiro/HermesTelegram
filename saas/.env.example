# Hermes SaaS — copie para .env (ou cole na aba Environment do stack no Dokploy).

# --- Canal WhatsApp (webhook UAZAPI): obrigatório ---
# Defina os DOIS. O webhook do UAZAPI deve apontar p/ https://<dominio-do-bot>/webhook.
UAZAPI_BASE_URL=https://sua-instancia.uazapi.com
UAZAPI_TOKEN=seu_token_da_instancia
# PORT do servidor web do webhook.
PORT=8080

# --- Banco MySQL 8 (multi-tenant). Aplique antes: saas/database/schema.sql ---
MYSQL_HOST=mysql5045.site4now.net
MYSQL_PORT=3306
MYSQL_DB=hermes_saas
MYSQL_USER=seu_usuario
MYSQL_PASSWORD=sua_senha

# --- Cérebro (LLM): "ollama" (local, grátis, lento em CPU) ou "groq" (nuvem, rápido) ---
LLM_PROVIDER=groq
GROQ_API_KEY=gsk_sua_chave_groq
GROQ_MODEL=openai/gpt-oss-120b
# Se LLM_PROVIDER=ollama:
OLLAMA_MODEL=hermes3:8b
OLLAMA_MEM_LIMIT=6g

# --- Voz (Whisper + TTS via OpenAI). Deixe vazio p/ desligar a voz ---
OPENAI_API_KEY=sk-sua_chave_openai
OPENAI_TTS_VOICE=nova
REMINDER_VOICE=true

# --- Fuso horário (data/hora reais + varredura de lembretes) ---
TZ=America/Sao_Paulo
